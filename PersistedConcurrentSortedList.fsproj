<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--<TargetFrameworks>netstandard2.0</TargetFrameworks>-->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <EnablePackageValidation>false</EnablePackageValidation>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <IsPackable>true</IsPackable>
	  <OutputPath>./bin</OutputPath>
	  <Description>SortedList with persistency and threadsafty.</Description>
	  <PackageProjectUrl>https://github.com/ingted/PersistedConcurrentSortedList</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/ingted/PersistedConcurrentSortedList</RepositoryUrl>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageTags>fsharp;sortedlist;storage;persistence;protobuf;fspickler</PackageTags>
	  <Configurations>Debug;Release;DbgWithNoDep</Configurations>
  </PropertyGroup>

  <ItemGroup>

	  <None Include="README.md" Pack="true" PackagePath="\" />
	  <Compile Include="Compression.fsx" />
	  <Compile Include="Memory.fsx" />
	  <None Include="PB2.fsx" />
	  <Compile Include="PB.fsx" />
	  <Compile Include="ChunkedValue.fs" />
	  <Compile Include="CSL.fsx" />
	  <Compile Include="CSL2.fsx" />
	  <Compile Include="Task.fsx" />
	  <!--<None Include="PB 20241017 before use mailboxprocessor.fsx" />
	  <None Include="PB 20241014.before_change.fsx" />
	  <None Include="PB 20241014.fsx" />-->
      <Compile Include="PCSL.fsx" />
      <Compile Include="PCSL2.fsx" />
      <Compile Include="DefaultHelper.fsx" />
      <Compile Include="QuickStart.fsx" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="FAkka.FCell2" Version="10.2.2" />
	<PackageReference Include="FAkka.ProtoBuf.FSharp" Version="10.2.2" />
	<PackageReference Include="FAkka.FSharp.Collections.ParallelSeq" Version="10.2.0" Condition="'$(Configuration)'=='Release'" />
	<PackageReference Include="protobuf-net.Core" Version="3.4.40" />
	<PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.13" />
	<ProjectReference Include="..\..\..\Libs\FSharp.Collections.ParallelSeq\src\FSharp.Collections.ParallelSeq\FSharp.Collections.ParallelSeq.fsproj" Condition="'$(Configuration)'=='Debug'" />
    <!--<ProjectReference Include="..\NTDLS.Katzebase.Parsers.Generic\NTDLS.Katzebase.Parsers.Generic.csproj" Condition="$(DefineConstants.Contains('KATZEBASE'))" />-->
    <ProjectReference Include="..\protobuf-net-fsharp\src\ProtoBuf.FSharp\ProtoBuf.FSharp.fsproj" Condition="'$(Configuration)'=='Debug'" />
  </ItemGroup>
	
  <ItemGroup>
    <PackageReference Include="FAkka.FsPickler" Version="10.2.0" />
    <PackageReference Include="FAkka.FsPickler.Json" Version="10.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="FSharp.Collections.ParallelSeq" Condition="'$(Configuration)'=='DbgWithNoDep'">
      <HintPath>..\..\..\Libs\FSharp.Collections.ParallelSeq\src\FSharp.Collections.ParallelSeq\bin\netstandard2.0\FSharp.Collections.ParallelSeq.dll</HintPath>
    </Reference>
  </ItemGroup>

	<PropertyGroup>
		<PackageId>$(AssemblyName)</PackageId>
	  <Version>10.2.6</Version>
	</PropertyGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.402" />
  </ItemGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <Optimize>False</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
	  <Optimize>true</Optimize>
	</PropertyGroup>


  <ItemGroup>
    <None Include="..\..\..\PostBuildEvent.ps1" Link="PostBuildEvent.ps1" />
  </ItemGroup>

  <Target Name="PostPackNugetDeployWindows" AfterTargets="Pack" Condition="$([MSBuild]::IsOSPlatform('Windows')) and ('$(Configuration)' == 'Debug' or '$(Configuration)' == 'Release')">
    <Exec Condition="'$(Configuration)' == 'Debug' or '$(SkipNuGetPush)' == 'true'" Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\..\PostBuildEvent.ps1&quot; -PackageId &quot;$(PackageId)&quot; -PackageVersion &quot;$(PackageVersion)&quot; -Configuration &quot;$(Configuration)&quot; -ProjectDirectory &quot;$(MSBuildProjectDirectory)&quot; -PackageFilePath &quot;$([System.IO.Path]::Combine('$(PackageOutputPath)', '$(PackageId).$(PackageVersion).nupkg'))&quot;" />
    <Exec Condition="'$(Configuration)' == 'Release' and '$(SkipNuGetPush)' != 'true'" Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\..\PostBuildEvent.ps1&quot; -PackageId &quot;$(PackageId)&quot; -PackageVersion &quot;$(PackageVersion)&quot; -Configuration &quot;$(Configuration)&quot; -ProjectDirectory &quot;$(MSBuildProjectDirectory)&quot; -PackageFilePath &quot;$([System.IO.Path]::Combine('$(PackageOutputPath)', '$(PackageId).$(PackageVersion).nupkg'))&quot; -PushRelease" />
  </Target>


</Project>
