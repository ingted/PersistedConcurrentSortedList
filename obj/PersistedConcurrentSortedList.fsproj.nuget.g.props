<?xml version="1.0" encoding="utf-8" standalone="no"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <RestoreSuccess Condition=" '$(RestoreSuccess)' == '' ">True</RestoreSuccess>
    <RestoreTool Condition=" '$(RestoreTool)' == '' ">NuGet</RestoreTool>
    <ProjectAssetsFile Condition=" '$(ProjectAssetsFile)' == '' ">$(MSBuildThisFileDirectory)project.assets.json</ProjectAssetsFile>
    <NuGetPackageRoot Condition=" '$(NuGetPackageRoot)' == '' ">/root/.nuget/packages/</NuGetPackageRoot>
    <NuGetPackageFolders Condition=" '$(NuGetPackageFolders)' == '' ">/root/.nuget/packages/</NuGetPackageFolders>
    <NuGetProjectStyle Condition=" '$(NuGetProjectStyle)' == '' ">PackageReference</NuGetProjectStyle>
    <NuGetToolVersion Condition=" '$(NuGetToolVersion)' == '' ">7.0.0</NuGetToolVersion>
  </PropertyGroup>
  <ItemGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <SourceRoot Include="/root/.nuget/packages/" />
  </ItemGroup>
  <ItemGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <Content Include="$(NuGetPackageRoot)fakka.protobuf.fsharp/10.0.103.2-dgx/contentFiles/any/net10.0/app.config" Condition="Exists('$(NuGetPackageRoot)fakka.protobuf.fsharp/10.0.103.2-dgx/contentFiles/any/net10.0/app.config')">
      <NuGetPackageId>FAkka.ProtoBuf.FSharp</NuGetPackageId>
      <NuGetPackageVersion>10.0.103.2-dgx</NuGetPackageVersion>
      <NuGetItemType>Content</NuGetItemType>
      <Pack>false</Pack>
      <Private>False</Private>
      <Link>app.config</Link>
    </Content>
  </ItemGroup>
  <PropertyGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <PkgSystem_Runtime_CompilerServices_Unsafe Condition=" '$(PkgSystem_Runtime_CompilerServices_Unsafe)' == '' ">/root/.nuget/packages/system.runtime.compilerservices.unsafe/6.1.2</PkgSystem_Runtime_CompilerServices_Unsafe>
    <PkgSystem_Collections_Immutable Condition=" '$(PkgSystem_Collections_Immutable)' == '' ">/root/.nuget/packages/system.collections.immutable/10.0.5</PkgSystem_Collections_Immutable>
    <Pkgprotobuf-net_Core Condition=" '$(Pkgprotobuf-net_Core)' == '' ">/root/.nuget/packages/protobuf-net.core/3.2.56</Pkgprotobuf-net_Core>
    <PkgFSharp_Core Condition=" '$(PkgFSharp_Core)' == '' ">/root/.nuget/packages/fsharp.core/10.0.105</PkgFSharp_Core>
    <PkgFAkka_ProtoBuf_FSharp Condition=" '$(PkgFAkka_ProtoBuf_FSharp)' == '' ">/root/.nuget/packages/fakka.protobuf.fsharp/10.0.103.2-dgx</PkgFAkka_ProtoBuf_FSharp>
    <PkgAkka_Analyzers Condition=" '$(PkgAkka_Analyzers)' == '' ">/root/.nuget/packages/akka.analyzers/0.3.3</PkgAkka_Analyzers>
    <PkgFAkka_FsPickler Condition=" '$(PkgFAkka_FsPickler)' == '' ">/root/.nuget/packages/fakka.fspickler/10.0.103.2-dgx</PkgFAkka_FsPickler>
    <PkgFAkka_FsPickler_Json Condition=" '$(PkgFAkka_FsPickler_Json)' == '' ">/root/.nuget/packages/fakka.fspickler.json/10.0.103.2-dgx</PkgFAkka_FsPickler_Json>
    <PkgFAkka_FSharp_Collections_ParallelSeq Condition=" '$(PkgFAkka_FSharp_Collections_ParallelSeq)' == '' ">/root/.nuget/packages/fakka.fsharp.collections.parallelseq/10.0.103.2-dgx</PkgFAkka_FSharp_Collections_ParallelSeq>
  </PropertyGroup>
</Project>