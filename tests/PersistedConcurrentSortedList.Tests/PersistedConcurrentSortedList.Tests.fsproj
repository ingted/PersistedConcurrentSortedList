<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
    <Reference Include="PersistedConcurrentSortedList">
      <HintPath>$(PcslAssemblyPath)</HintPath>
    </Reference>
    <PackageReference Include="Expecto" Version="11.1.0" />
    <PackageReference Include="FAkka.FCell2" Version="10.1.400" />
    <PackageReference Include="FAkka.ProtoBuf.FSharp" Version="10.1.400" />
    <PackageReference Include="FAkka.FSharp.Collections.ParallelSeq" Version="10.1.400" />
    <PackageReference Include="FAkka.FsPickler" Version="10.1.400" />
    <PackageReference Include="FAkka.FsPickler.Json" Version="10.1.400" />
    <PackageReference Update="FSharp.Core" Version="10.1.400" />
  </ItemGroup>
  <Target Name="RequirePcslCandidate" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(PcslAssemblyPath)')" Text="Provide the exact built native candidate through PcslAssemblyPath." />
  </Target>
</Project>
