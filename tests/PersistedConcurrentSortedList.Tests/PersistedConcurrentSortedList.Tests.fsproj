<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>false</IsPackable>
    <Optimize Condition="'$(Configuration)'=='Release'">true</Optimize>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);PCSL_MERGED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../doc/RFC/20261006.25MB.Chunk/ParseLine.fsx" />
    <Compile Include="../../doc/RFC/20261006.25MB.Chunk/TEST.fsx" />
    <Compile Include="ChunkStorageTests.fs" />
    <Compile Include="ChunkRecoveryTests.fs" />
    <Compile Include="ChunkSafetyTests.fs" />
    <Compile Include="Program.fs" />
    <Reference Include="PersistedConcurrentSortedList">
      <HintPath>$(PcslAssemblyPath)</HintPath>
    </Reference>
    <PackageReference Include="Expecto" Version="11.1.0" />
    <PackageReference Include="FAkka.Argu" Version="[10.1.400]" />
    <PackageReference Include="FAkka.FCell2" Version="10.1.400" />
    <PackageReference Include="FAkka.ProtoBuf.FSharp" Version="10.1.400" />
    <PackageReference Include="FAkka.FSharp.Collections.ParallelSeq" Version="10.1.400" />
    <PackageReference Include="FAkka.FsPickler" Version="10.1.400" />
    <PackageReference Include="FAkka.FsPickler.Json" Version="10.1.400" />
    <PackageReference Update="FSharp.Core" Version="10.1.400" />
  </ItemGroup>
  <Target Name="RequirePcslCandidate" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(PcslAssemblyPath)')" Text="Provide the exact built native candidate through PcslAssemblyPath." />
  </Target>
</Project>
